---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ metadata.title }} Blog</title>
        <link>{{ metadata.url }}/blog/</link>
        <description>{{ metadata.description }}</description>
        <language>en-us</language>
        <atom:link href="{{ metadata.url }}/feed.xml" rel="self" type="application/rss+xml" />
        {% for post in collections.posts %}
        <item>
            <title>{{ post.data.title }}</title>
            <link>{{ metadata.url }}{{ post.url }}</link>
            <guid isPermaLink="true">{{ metadata.url }}{{ post.url }}</guid>
            <pubDate>{{ post.date | rfc822Date }}</pubDate>
            {% if post.data.author %}<author>{{ post.data.author }}</author>{% endif %}
            <description><![CDATA[ {{ post.templateContent | safe }} ]]></description>
        </item>
        {% endfor %}
    </channel>
</rss>
