<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {% if page.url == "/" %}{% set pageTitle = title %}{% else %}{% set pageTitle = title + " | Crimson Defense" %}{% endif %}
    <title>{{ pageTitle }}</title>
    <meta name="description" content="{{ description or metadata.description }}">
    <link rel="canonical" href="{{ metadata.url }}{{ page.url }}">

    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ description or metadata.description }}">
    <meta property="og:url" content="{{ metadata.url }}{{ page.url }}">
    <meta property="og:image" content="{{ metadata.url }}/img/{{ ogImage or 'transparentCDLogo.png' }}">

    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
    {% if page.url == "/" %}
    <link rel="stylesheet" href="/css/index.css">
    {% endif %}
    {% if page.url == "/about/" %}
    <link rel="stylesheet" href="/css/about.css">
    {% endif %}
    {% if page.url == "/competition-team/" %}
    <link rel="stylesheet" href="/css/competition-team.css">
    {% endif %}
    {% if page.url == "/contact-us/" %}
    <link rel="stylesheet" href="/css/contact-us.css">
    {% endif %}
    {% if page.url == "/faqs/" %}
    <link rel="stylesheet" href="/css/faqs.css">
    {% endif %}
    {% if page.url == "/outreach/" %}
    <link rel="stylesheet" href="/css/outreach.css">
    {% endif %}
    {% if page.url == "/club-leadership/" %}
    <link rel="stylesheet" href="/css/club-leadership.css">
    {% endif %}
    {% if page.url == "/meetings/" %}
    <link rel="stylesheet" href="/css/meetings.css">
    {% endif %}
    {% if page.url == "/cdctf/" %}
    <link rel="stylesheet" href="/css/cdctf.css">
    {% endif %}
    {% if page.url == "/uactf/" %}
    <link rel="stylesheet" href="/css/uactf.css">
    {% endif %}
    {% if page.url == "/scoreboard/" %}
    <link rel="stylesheet" href="/css/scoreboard.css">
    {% endif %}
    {% if "/writeups/" in page.url %}
    <link rel="stylesheet" href="/css/writeup.css">
    {% endif %}
    {% if page.url == "/blog/" or "/posts/" in page.url %}
    <link rel="stylesheet" href="/css/blog.css">
    {% endif %}
    {% if "/posts/" in page.url %}
    <link rel="stylesheet" href="/css/writeup.css">
    {% endif %}
    <link rel="alternate" type="application/rss+xml" title="{{ metadata.title }} Blog" href="/feed.xml">


    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@300..700&family=Kumbh+Sans:wght@300..700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
        <defs>
            <symbol id="elz" viewBox="0 0 200 150">
                <g fill="currentColor">
                    <ellipse cx="125" cy="72" rx="58" ry="42"/>
                    <rect x="80" y="95" width="18" height="49" rx="8"/>
                    <rect x="104" y="95" width="18" height="49" rx="8"/>
                    <rect x="128" y="95" width="18" height="49" rx="8"/>
                    <rect x="152" y="95" width="18" height="49" rx="8"/>
                    <circle cx="62" cy="66" r="38"/>
                    <ellipse cx="80" cy="60" rx="26" ry="33"/>
                </g>
                <path d="M38 88 C24 104 26 126 42 134" fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="round"/>
                <path d="M182 58 C195 66 195 84 188 94" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>
            </symbol>

            <pattern id="elz-tile" width="130" height="130" patternUnits="userSpaceOnUse">
                <g color="#9E1B32">
                    <use href="#elz" x="9" y="16" width="28" height="21"/>
                    <use href="#elz" width="28" height="21" transform="translate(121,80) scale(-1,1)"/>
                </g>
            </pattern>
        </defs>
    </svg>

    <svg class="page-bg" aria-hidden="true">
        <rect x="0" y="0" width="100%" height="100%" fill="url(#elz-tile)" opacity=".12"/>
    </svg>

    {% include "nav.njk" %}

    <main id="main">
        {{content | safe }}
    </main>

    {% include "footer.njk" %}
</body>
</html>